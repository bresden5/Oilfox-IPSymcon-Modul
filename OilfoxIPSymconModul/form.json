{
  "elements": [
    {
      "type": "ExpansionPanel",
      "caption": "Instanz-Steuerung",
      "items": [
        {
          "type": "CheckBox",
          "name": "Active",
          "caption": "Instanz aktiv"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Zugangsdaten",
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "Email",
          "caption": "E-Mail-Adresse"
        },
        {
          "type": "PasswordTextBox",
          "name": "Password",
          "caption": "Passwort"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Geräte",
      "items": [
        {
          "type": "ValidationTextBox",
          "name": "DeviceIDs",
          "caption": "Geräte IDs (kommagetrennt)"
        }
      ]
    },
    {
      "type": "ExpansionPanel",
      "caption": "Update-Einstellungen",
      "items": [
        {
          "type": "NumberSpinner",
          "name": "UpdateInterval",
          "caption": "Updateintervall",
          "minimum": 300,
          "suffix": "Sekunden"
        },
        {
          "type": "CheckBox",
          "name": "Debug",
          "caption": "Debug-Ausgaben aktivieren"
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "Button",
      "caption": "📡 Jetzt aktualisieren",
      "onClick": "OILFOX_Update($id);"
    }
  ],
  "status": [
    {
      "code": 102,
      "icon": "active",
      "caption": "Aktiv"
    },
    {
      "code": 201,
      "icon": "error",
      "caption": "Login fehlgeschlagen"
    },
    {
      "code": 202,
      "icon": "error",
      "caption": "API nicht erreichbar"
    }
  ]
}
